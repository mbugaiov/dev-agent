# Bitbucket API — copy to projects/<slug>/.secrets/bitbucket.env (never commit)
# Create scoped API token at https://id.atlassian.com/manage-profile/security/api-tokens
# Hephaestus needs (at minimum):
#   read:repository:bitbucket read:pullrequest:bitbucket read:pipeline:bitbucket
#   write:pullrequest:bitbucket write:repository:bitbucket
# Read-only tokens can push via SSH but cannot open/merge MRs.
BITBUCKET_USERNAME=
BITBUCKET_TOKEN=
BITBUCKET_WORKSPACE=
