# Jira API — copy to projects/<slug>/.secrets/jira.env (never commit)
JIRA_BASE_URL=https://your-co.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TST

# Optional: Power Automate webhook for dev factory tick summaries (execute / idle).
# Leave commented to disable — an unset value is not an error.
# ALWAYS QUOTE the value: it contains `&`, and an unquoted value is truncated to
# empty by the shell, which silently disables notifications.
# DEV_FACTORY_TEAMS_WEBHOOK_URL="https://....powerplatform.com/.../invoke?api-version=1&sp=...&sig=..."
